// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model forum {
  id       String    @id @default(uuid())
  name     String
  messages message[]
}

model message {
  id      String  @id @default(uuid())
  content String
  forum   forum?  @relation(fields: [forumId], references: [id])
  forumId String?
}

model listings {
  id          String @id @default(uuid())
  name        String
  price       String
  description String
  bids        Bid[]
}

model Bid {
  id         String    @id @default(uuid())
  status     Boolean?
  value      String
  listings   listings? @relation(fields: [listingsId], references: [id])
  listingsId String?
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model character {
  id      String @id @default(uuid())
  name    String @unique
  desc    String
  image  Image?
  games Int @default(0)
  wins Int  @default(0)
  currentstreak Int @default(0)
  higheststreak Int @default(0)

  won_games Game[] @relation("won")
  lost_games Game[] @relation("lost")
}

model Image {
  id          String     @id @default(uuid())
  encoding    String
  character   character @relation(fields: [characterId], references: [id])
  characterId String @unique
}

model Game {
  id String  @id @default(uuid())
  win character @relation("won", fields: [winnercharacterId], references: [id])
  loss character @relation("lost", fields: [losercharacterId], references: [id])
  winnercharacterId String
  losercharacterId String
  createdAt DateTime  @default(now())
}

model Person {
 id String  @id @default(uuid())
 name String @unique 
 age Int
 adress String 
}